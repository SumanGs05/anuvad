# =============================================================================
# Anuvad Backend - Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to git.
# =============================================================================

# Application
NODE_ENV=development
PORT=5000

# MongoDB connection string.
# Required in production. In development you can run MongoDB locally.
MONGODB_URI=mongodb://localhost:27017/anuvad

# JWT secrets. Must each be at least 32 characters and must be different.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Sarvam AI API key. Required for translation to work.
SARVAM_API_KEY=
SARVAM_API_BASE_URL=https://api.sarvam.ai

# MongoDB field-level encryption keys.
# Required in production. Both must be at least 32 characters and must be different.
# Warning: changing these after data has been written makes existing records unreadable.
MONGO_ENCRYPTION_KEY=
MONGO_SIGNING_KEY=

# CORS origin. Set to the exact frontend URL with no trailing slash.
# In production: must not be localhost or a wildcard.
CORS_ORIGIN=http://localhost:5173

# Trust proxy. Set to 1 when deployed behind Railway (or any single-hop proxy).
# Controls how rate limiters identify client IPs from X-Forwarded-For.
TRUST_PROXY=1

# Storage directory for uploaded and translated files.
# In production: set to the Railway volume mount path (e.g. /data/storage).
# In development: leave empty to use the default backend/storage/ directory.
STORAGE_DIR=

# Retention: delete uploaded and translated files after this many days.
RETENTION_DAYS=7

# Maximum translation jobs per user per rolling 24-hour window.
DAILY_JOB_LIMIT=10

# Maximum number of pages in a PDF. PDFs exceeding this are rejected.
MAX_PDF_PAGES=50

# Maximum number of translation pipelines running concurrently.
MAX_CONCURRENT_JOBS=2

# Set to false to prevent new user registrations (useful for private deployments).
REGISTRATION_ENABLED=true
