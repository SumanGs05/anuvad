# ---------------------------------------------------------------------------
# Anuvad backend - environment variables
# Copy this file to `.env` and fill in real values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# MongoDB (local instance or free Atlas cluster)
MONGODB_URI=

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Sarvam AI
SARVAM_API_KEY=
SARVAM_API_BASE_URL=https://api.sarvam.ai

# Mongoose field-level encryption (32-byte base64 keys recommended)
MONGO_ENCRYPTION_KEY=
MONGO_SIGNING_KEY=

# CORS - comma separated list of allowed origins for the local frontend
CORS_ORIGIN=http://localhost:5173
